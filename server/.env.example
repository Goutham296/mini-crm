# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/minicrm?retryWrites=true&w=majority
# Long random string used to sign JWTs (required), e.g. `openssl rand -hex 48`
JWT_SECRET=replace-with-a-long-random-string
# Allowed frontend origin(s), comma-separated, no trailing slash (required)
CLIENT_URL=https://your-frontend.vercel.app
# Port to listen on (Render sets this automatically)
PORT=4000
# development | production | test
NODE_ENV=development
